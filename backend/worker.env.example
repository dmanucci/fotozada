# Supabase (use a service role key — nunca a anon key)
SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_KEY=SEU-SERVICE-ROLE-KEY

# CUPS — nome exato da impressora (veja: lpstat -p)
PRINTER_NAME=DNP_RX1

# Storage bucket onde os PNGs compostos ficam
STORAGE_BUCKET=prints

# Tentativas em caso de falha
MAX_RETRIES=3
RETRY_DELAY=5

# Polling do CUPS (quanto esperar entre verificações se o papel saiu)
CUPS_POLL_INTERVAL=1
CUPS_TIMEOUT=300

# Rede de segurança do Realtime (segundos entre checagens da fila no banco)
POLL_INTERVAL=5

# Espera fixa após o job sair do CUPS, antes de pegar o próximo. É o maior
# tempo "parado" por job: se a impressora leva ~15s por folha, 30 aqui deixa
# ~15s ociosos por job. Meça pelo log (linha "⏱") e ajuste com cuidado.
PRINT_COMPLETE_DELAY=30
